# Vercelのサーバー環境変数。VITE_を付けない。秘密値をGitに追加しない。
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Authで作成した2人のUUID。1人目が管理者。
ONLINE_MEMBER_1=
ONLINE_MEMBER_2=
# 32文字以上のランダムな値。Cron側にも同じ秘密値を設定する。
ONLINE_CRON_SECRET=
# 検証用の「1時間進める」を管理者に出す（1 で有効）。遊び始めたら外すこと。
ONLINE_ALLOW_STEP=

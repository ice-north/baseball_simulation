# Vercelのサーバー環境変数。VITE_を付けない。秘密値をGitに追加しない。
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 管理者のUUID（Supabase Authで作成したユーザー）。
# 参加者はリーグのデータ側で管理するので、ここには書かない。招待コードで増やす。
ONLINE_ADMIN=
# 32文字以上のランダムな値。Cron側にも同じ秘密値を設定する。
ONLINE_CRON_SECRET=
# 検証用の「1時間進める」を管理者に出す（1 で有効）。遊び始めたら外すこと。
ONLINE_ALLOW_STEP=
# 観戦リプレイ（1球ごとの記録）を保存する（1 で有効）。既定は保存しない。
# ⚠ 1試合あたり約180KB増える。球団数が多いと保存が破綻するので、見積もってから有効にすること。
ONLINE_RECORD_REPLAY=

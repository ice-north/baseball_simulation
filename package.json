{
  "name": "baseball-simulation",
  "version": "2.0.0",
  "type": "module",
  "description": "野球シミュレーションゲーム",
  "scripts": {
    "dev": "vite",
    "dev:online": "node server/dev.mjs",
    "build": "vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "check:quick": "node tools/sim-harness/run-checks.mjs quick",
    "check": "node tools/sim-harness/run-checks.mjs check",
    "check:season": "node tools/sim-harness/season-check.mjs",
    "check:draft": "node tools/sim-harness/draft-check.mjs",
    "check:bracket": "node tools/sim-harness/bracket-check.mjs",
    "check:progression": "node tools/sim-harness/progression-check.mjs",
    "check:full": "node tools/sim-harness/run-checks.mjs full",
    "check:scope": "node tools/sim-harness/scope-check.mjs",
    "check:contract": "node tools/sim-harness/contract-scope-check.mjs",
    "check:pool": "node tools/sim-harness/pool-leak-check.mjs",
    "check:doc": "node tools/sim-harness/doc-check.mjs",
    "check:bunt": "node tools/sim-harness/bunt-check.mjs",
    "check:online": "node tools/sim-harness/run-checks.mjs online",
    "check:online:season": "node tools/sim-harness/online-engine-check.mjs",
    "check:online:storage": "node tools/sim-harness/online-storage-check.mjs",
    "check:online:ui": "node tools/sim-harness/online-ui-check.mjs",
    "check:online:auth-ui": "node tools/sim-harness/online-auth-ui-check.mjs",
    "check:online:edit-ui": "node tools/sim-harness/online-edit-ui-check.mjs",
    "check:online:lineup-ui": "node tools/sim-harness/online-lineup-board-ui-check.mjs",
    "check:online:trade-ui": "node tools/sim-harness/online-trade-ui-check.mjs",
    "check:online:join-ui": "node tools/sim-harness/online-join-ui-check.mjs",
    "check:online:staff-ui": "node tools/sim-harness/online-staff-ui-check.mjs",
    "check:online:replay-ui": "node tools/sim-harness/online-replay-ui-check.mjs",
    "check:online:mobile-gameplay-ui": "node tools/sim-harness/online-mobile-gameplay-ui-check.mjs",
    "check:online:label-ui": "node tools/sim-harness/online-label-ui-check.mjs",
    "check:ui": "vite build && node tools/sim-harness/singleplayer-ui-check.mjs",
    "scenes": "vite build && node tools/sim-harness/singleplayer-ui-check.mjs --scenes",
    "scene": "node tools/sim-harness/open-scene.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.58.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.12",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
